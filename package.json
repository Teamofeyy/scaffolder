{
  "name": "scaffolder",
  "version": "0.9.0-beta.1",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install && cargo fetch --manifest-path apps/api/Cargo.toml --locked",
    "install:all": "pnpm run bootstrap",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=nextjs-scaffolder",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=nextjs-scaffolder",
    "build:api": "turbo run build --filter=api",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "turbo run format:check",
    "check": "turbo run format:check lint typecheck test",
    "deps:update-presets": "node apps/api/scripts/update-dependency-presets.mjs",
    "load:test": "node scripts/load-test.mjs",
    "load:test:preview": "LOAD_TEST_ENDPOINT=preview node scripts/load-test.mjs",
    "load:test:generate": "LOAD_TEST_ENDPOINT=generate node scripts/load-test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "turbo": "^2.9.9"
  }
}
