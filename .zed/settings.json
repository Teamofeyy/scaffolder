{
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "formatter": [
        { "code_action": "source.fixAll.eslint" },
        {
          "external": {
            "command": "pnpm",
            "arguments": [
              "--dir",
              "apps/web",
              "exec",
              "prettier",
              "--stdin-filepath",
              "{buffer_path}"
            ]
          }
        }
      ],
      "format_on_save": "on"
    },
    "TypeScript": {
      "formatter": [
        { "code_action": "source.fixAll.eslint" },
