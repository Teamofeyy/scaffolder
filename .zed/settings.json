  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectories": [{ "mode": "auto" }]
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    }
  }
