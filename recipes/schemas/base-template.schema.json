{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaffolder.local/schemas/base-template.schema.json",
  "title": "Scaffolder base template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "name", "description", "status", "snapshotPath", "source", "provides"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "verified", "promoted"] },
    "snapshotPath": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "ref", "path"],
      "properties": {
        "kind": { "enum": ["github", "submodule"] },
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
