{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaffolder.local/schemas/base-template.schema.json",
  "title": "Scaffolder base template manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "name",
    "description",
    "status",
    "snapshotPath",
    "source",
    "snapshot",
    "provides"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "verified", "promoted"] },
    "snapshotPath": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "ref", "path"],
      "properties": {
        "kind": { "enum": ["github", "submodule"] },
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path", "hash", "promotedAt"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "promotedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
