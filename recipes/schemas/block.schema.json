{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scaffolder.local/schemas/block.schema.json",
  "title": "Scaffolder block manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "name",
    "description",
    "category",
    "status",
    "requires",
    "conflicts",
    "provides",
    "filesTouched",
    "operations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "enum": ["integration", "starter"] },
    "status": { "enum": ["draft", "experimental", "stable", "deprecated"] },
    "requires": { "$ref": "#/$defs/requires" },
    "conflicts": { "$ref": "#/$defs/conflicts" },
    "provides": { "$ref": "#/$defs/capabilities" },
    "filesTouched": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target", "description"],
        "properties": {
          "type": {
            "enum": [
              "package-json-merge",
              "tsconfig-merge",
              "components-json-merge",
              "css-append",
              "file-template",
              "file-copy",
              "text-patch"
            ]
          },
          "target": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "template": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseTemplates", "blocks", "capabilities"],
      "properties": {
        "baseTemplates": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "conflicts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks", "capabilities"],
      "properties": {
        "blocks": { "type": "array", "items": { "type": "string" } },
        "capabilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
